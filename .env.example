APP_NAME=PhotoCraft
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The app owns no tables of its own. Cache, session and queue are deliberately
# kept OFF the database driver so Laravel never creates a `cache`, `sessions` or
# `jobs` table in the PhotoCraft schema - the schema is owned by
# graspcraft_backend/db/schema.sql and must not drift.
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

DB_CONNECTION=pgsql

# ─────────────────────────────────────────────────────────────────────────────
# Everything below is copied from graspcraft_backend/.env, key names unchanged,
# so a deployed server's env file can be reused as-is.
# ─────────────────────────────────────────────────────────────────────────────

AWS_REGION=ap-southeast-1
# IAM user photocraft-app-dev, policy photocraft-app-s3-rekognition.
# Verified against all three photocraft-* buckets. If uploads start returning 403,
# check this value's length first - it must be exactly 40 characters, with no
# stray "=" and no trailing whitespace.
AWS_ACCESSKEY_ID=
AWS_SECRET_ACCESSKEY_ID=

# IAM user photocraft-app-prod, policy photocraft-app-s3-rekognition-prod.
# Used ONLY when NODE_ENV is exactly "prod". Scoped to the -prod buckets, so it
# cannot touch dev - and the dev key cannot touch prod.
AWS_PROD_ACCESSKEY_ID=
AWS_PROD_SECRET_ACCESSKEY_ID=

#dev
# Three buckets, split purely by retention. See
# graspcraft_backend/docs/S3_PHOTOCRAFT_SETUP.md

# bucket 1 - raw photographer captures. 1-day lifecycle expiry (set in AWS).
AWS_BUCKET_NAME=photocraft-photos-dev

# bucket 2 - completed / framed order images. 7-day lifecycle expiry (set in AWS).
AWS_FRAMED_IMAGES_BUCKET=photocraft-orders-dev

# bucket 3 - masters: frames, products, combos, object masters, staff avatars.
# Permanent, no lifecycle rule. These three MUST hold the same value - the upload
# path decides what to do from uploadType, never from the bucket name, so sharing
# one bucket is safe. Change all three together or none.
AWS_FRAME_BUCKET=photocraft-masters-dev
AWS_PRODUCTCOMBO_BUCKET=photocraft-masters-dev
AWS_ADS_BUCKET=photocraft-masters-dev

# unchanged on purpose - renaming this empties the face index
AWS_REQ_COLLECTIONID=face-collections

# Windows PHP ships no CA bundle, so every AWS call fails TLS verification until
# curl is pointed at one. Leave this UNSET on a deployed Linux server - the
# system trust store is correct there and hardcoding a path would break it.
AWS_CA_BUNDLE=

#prod
# WARNING: these buckets DO NOT EXIST YET. NODE_ENV must be exactly "prod" for
# them to be used, so local dev is unaffected - but a prod deploy fails on the
# first upload.
AWS_BUCKET_NAME_PROD=photocraft-photos-prod
AWS_FRAMED_IMAGES_BUCKET_PROD=photocraft-orders-prod
AWS_FRAME_BUCKET_PROD=photocraft-masters-prod
AWS_PRODUCTCOMBO_BUCKET_PROD=photocraft-masters-prod
AWS_ADS_BUCKET_PROD=photocraft-masters-prod
AWS_REQ_COLLECTIONID_PROD=face-collections-prod

#Mails crendentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=

#token
JWT_SECRET=

# NOTE: the Node .env also carries ALGORITHM / SECRET_KEY / IV. They are dead
# entries - CryptoUtil.ts hardcodes its key and IV and never reads them, and the
# values there are not even well formed (trailing `;` and `// 32 chars`). They
# are deliberately NOT carried over: App\Support\Crypto hardcodes the same
# constants the Node code does, because every encrypted row in the live database
# was written with them.

# Link put into the customer's soft-copy email. It points at the PANEL app's
# /image_viewer route, not at the API, and it is customer-facing - a wrong value
# here sends real customers to a dead page.
#   live: https://panel.photocraftai.cloud/image_viewer/
#   dev : https://paneldev.photocraftai.cloud/image_viewer/
EMAILSENT_LINK=http://localhost:4200/image_viewer/

##Db connection
# Selects the connection block in config/database.php. The switch matches the
# literals 'local', 'dev' and 'prod' and falls back to local for anything else -
# so this value, "development", resolves to the LOCAL database. That is the
# existing Node behaviour (database.service.ts), kept deliberately.
NODE_ENV=development

#my local db
DB_USER_LOCAL=
DB_HOST_LOCAL=localhost
DB_NAME_LOCAL=facecraft
DB_PASSWORD_LOCAL=
DB_PORT_LOCAL=5432

#dev
DB_HOST_DEV=
DB_PORT_DEV=5432
DB_USER_DEV=
DB_PASSWORD_DEV=
DB_NAME_DEV=facecraft_dev

#prod
DB_HOST_PROD=
DB_PORT_PROD=8952
DB_USER_PROD=
DB_PASSWORD_PROD=
DB_NAME_PROD=facecraft_prod

# Requests per client IP per minute. The deployed default is 300; local dev goes
# far higher because the SPA, the dev-server proxy and any test scripts all share
# one address.
RATE_LIMIT_MAX=10000

# Comma-separated list of origins allowed to call this API from a browser.
# On a deployed server set this to that environment's panel origin, e.g.
#   live: CORS_ORIGINS=https://panel.xyz.com
#   dev : CORS_ORIGINS=https://paneldev.xyz.com
CORS_ORIGINS=http://localhost:4200,http://localhost:3000
